{
  "name": "fullstack-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build",
    "lint": "pnpm --parallel lint",
    "test": "pnpm --filter server test && pnpm --filter client test && pnpm run test:miniprogram",
    "test:miniprogram": "node --test tests/miniprogram/*.test.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ]
  }
}
