<view class="page-container health-page">

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在检测密码安全性...</text>
  </view>

  <block wx:if="{{!loading}}">

    <!-- Score Dashboard -->
    <view class="card score-card">
      <view class="score-circle score-{{scoreLevel}}">
        <text class="score-number">{{score}}</text>
        <text class="score-label">安全评分</text>
      </view>
      <text class="score-summary">共 {{totalEntries}} 个密码</text>
    </view>

    <!-- All Safe Empty State -->
    <view class="card empty-state all-safe" wx:if="{{weakPasswords.length === 0 && reusedPasswords.length === 0 && oldPasswords.length === 0}}">
      <view class="safe-icon">✓</view>
      <text class="safe-text">所有密码都很安全!</text>
    </view>

    <!-- Weak Passwords Section -->
    <view class="card section section-weak" wx:if="{{weakPasswords.length > 0}}">
      <view class="section-header" bindtap="toggleSection" data-section="weak">
        <view class="section-title-wrap">
          <view class="section-indicator indicator-weak"></view>
          <text class="section-title">弱密码</text>
          <view class="count-badge badge-weak">{{weakPasswords.length}}</view>
        </view>
        <text class="section-arrow {{weakExpanded ? 'arrow-expanded' : ''}}">›</text>
      </view>
      <view class="section-body" wx:if="{{weakExpanded}}">
        <view class="entry-item" wx:for="{{weakPasswords}}" wx:key="id" bindtap="onEntryTap" data-id="{{item.id}}">
          <view class="entry-info">
            <text class="entry-title">{{item.title}}</text>
            <text class="entry-category tag">{{item.category}}</text>
          </view>
          <text class="entry-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- Reused Passwords Section -->
    <view class="card section section-reused" wx:if="{{reusedPasswords.length > 0}}">
      <view class="section-header" bindtap="toggleSection" data-section="reused">
        <view class="section-title-wrap">
          <view class="section-indicator indicator-reused"></view>
          <text class="section-title">重复密码</text>
          <view class="count-badge badge-reused">{{reusedPasswords.length}}</view>
        </view>
        <text class="section-arrow {{reusedExpanded ? 'arrow-expanded' : ''}}">›</text>
      </view>
      <view class="section-body" wx:if="{{reusedExpanded}}">
        <view class="entry-item" wx:for="{{reusedPasswords}}" wx:key="id" bindtap="onEntryTap" data-id="{{item.id}}">
          <view class="entry-info">
            <text class="entry-title">{{item.title}}</text>
            <text class="entry-category tag">{{item.category}}</text>
          </view>
          <text class="entry-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- Old Passwords Section -->
    <view class="card section section-old" wx:if="{{oldPasswords.length > 0}}">
      <view class="section-header" bindtap="toggleSection" data-section="old">
        <view class="section-title-wrap">
          <view class="section-indicator indicator-old"></view>
          <text class="section-title">老旧密码</text>
          <view class="count-badge badge-old">{{oldPasswords.length}}</view>
        </view>
        <text class="section-arrow {{oldExpanded ? 'arrow-expanded' : ''}}">›</text>
      </view>
      <view class="section-body" wx:if="{{oldExpanded}}">
        <view class="entry-item" wx:for="{{oldPasswords}}" wx:key="id" bindtap="onEntryTap" data-id="{{item.id}}">
          <view class="entry-info">
            <text class="entry-title">{{item.title}}</text>
            <text class="entry-category tag">{{item.category}}</text>
          </view>
          <text class="entry-arrow">›</text>
        </view>
      </view>
    </view>

  </block>
</view>
