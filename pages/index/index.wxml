<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索密码条目..."
      placeholder-style="color:#c0c4cc"
      value="{{searchText}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <view class="search-clear" wx:if="{{searchText}}" bindtap="onClearSearch">✕</view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view
      class="category-chip {{activeCategory === item.value ? 'category-chip-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="value"
      bindtap="onCategoryTap"
      data-category="{{item.value}}"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading && entries.length === 0}}">
    <view class="loading-spinner">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && entries.length === 0}}">
    <view class="empty-icon">🔐</view>
    <view class="empty-text">暂无密码条目</view>
    <view class="empty-hint">点击右下角按钮添加第一条密码</view>
  </view>

  <!-- 条目列表 -->
  <view class="entry-list" wx:else>
    <view
      class="card entry-card"
      wx:for="{{entries}}"
      wx:key="id"
      bindtap="onEntryTap"
      data-id="{{item.id}}"
    >
      <view class="entry-header">
        <view class="entry-title">{{item.title}}</view>
        <view class="entry-star {{item.favorite ? 'entry-star-active' : ''}}">★</view>
      </view>
      <view class="entry-username">{{item.username}}</view>
      <view class="entry-footer">
        <view class="tag tag-info entry-tag">{{item.category || '其他'}}</view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="onLoadMore">
      <view wx:if="{{loadingMore}}" class="load-more-text">加载中...</view>
      <view wx:else class="load-more-text">加载更多</view>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && entries.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" bindtap="onAdd">＋</view>
</view>
