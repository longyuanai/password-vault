/* 全局样式 */
page {
  background-color: #f0f2f5;
  color: #303133;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.page-container {
  padding: 24rpx;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ebeef5;
  margin-bottom: 24rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #409eff;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 按钮样式 */
.btn-primary {
  background-color: #409eff;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary[disabled] {
  background-color: #a0cfff;
}

.btn-success {
  background-color: #67c23a;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-danger {
  background-color: #f56c6c;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-warning {
  background-color: #e6a23c;
  color: #ffffff;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-default {
  background-color: #ffffff;
  color: #606266;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* Tag 样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-info {
  background-color: #ecf5ff;
  color: #409eff;
}

.tag-success {
  background-color: #f0f9eb;
  color: #67c23a;
}

.tag-warning {
  background-color: #fdf6ec;
  color: #e6a23c;
}

.tag-danger {
  background-color: #fef0f0;
  color: #f56c6c;
}

/* 居中卡片容器（用于 setup/unlock） */
.centered-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.centered-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #c0c4cc;
  font-size: 28rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #ebeef5;
  margin: 24rpx 0;
}

/* 提示消息 */
.alert {
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.alert-error {
  background-color: #fef0f0;
  color: #f56c6c;
  border: 1rpx solid #fbc4c4;
}

.alert-success {
  background-color: #f0f9eb;
  color: #67c23a;
  border: 1rpx solid #c2e7b0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}
